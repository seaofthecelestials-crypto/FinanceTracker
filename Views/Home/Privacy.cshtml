@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <h1>Privacy Policy</h1>

    <div class="row mt-4">
        <p class="lead">Last updated: September 2026</p>

        <h3>Introductions</h3>
        <p>
            This Privacy Policy describes how Finance Tracker collects, uses and protects your information.
            We are commited to protecting your privacy and ensuring the security of your personal and financial data.
        </p>

        <h3>Information We Collect</h3>
        <p>
            Finance Tracker collects the following types of information:
        </p>
        <ul>
            <li><strong>Transaction Data:</strong> Date, Description, Amount, and Category of your financial transactions</li>
            <li><strong>Deposit Information:</strong> Date, Description, Amount, and Form of your deposits</li>
            <li><strong>Useage Data:</strong> How you interact with the application (pages visited, features used)</li>
        </ul>

        <h3>How We Use Your Information</h3>
        <p>
            We use the collected information to:
        </p>
            <ul>
                <li>Provide and maintain the Finance Tracker service</li>
                <li>Display your financial data and insights</li>
                <li>Improve the application's functionality and user experience</li>
                <li>Respond to your inquiries and provide support</li>
            </ul>

            <h3>Data Storage and Security</h3>
            <p>
                Your data is stored securely using:
            </p>
            <ul>
                <li>SQL Server database with encryption at rest</li>
                <li>Secure authentication and access controls</li>
                <li>Regular security updates and monitoring</li>
            </ul>
            <p>
                We implement appropriate technical and organizational measures to protect your personal information
                against unauthorized access, alteration, disclosure, or destruction.
            </p>

            <h3>Data Retention</h3>
            <p>
                Your financial data is retained as long as you maintain your account. You can request deletion of
                your data at any time by contacting us through the contact page.
            </p>

            <h3>Your Rights</h3>
            <p>
                You have the right to:
            </p>
            <ul>
                <li>Access your personal data</li>
                <li>Request correction of inaccurate data</li>
                <li>Request deletion of your data</li>
                <li>Export your data in a machine-readable format</li>
                <li>Object to processing of your data</li>
            </ul>

            <h3>Third-Party Services</h3>
            <p>
                Finance Tracker may use third-party services for:
            </p>
            <ul>
                <li>Application hosting and infrastructure</li>
                <li>Analytics and performance monitoring</li>
                <li>Customer support communications</li>
            </ul>
            <p>
                These third parties have access to your information only to perform specific tasks
                and are obligated not to disclose or use it for any other purpose.
            </p>
            
            <h3>Children's Privacy</h3>
            <p>
                Finance Tracker is not intended for use by children under the age of 13. We do not knowingly
                collect personal information from children under 13.
            </p>

            <h3>Changes to This Privacy Policy</h3>
            <p>
                We may update this Privacy Policy from time to time. We will notify you of any changes by
                posting the new Privacy Policy on this page and updating the "Last Updated" date.
            </p>

            <h3>Contact Us</h3>
            <p>
                If you have any questions about this Privacy Policy or our data practices, please contact us
                through our <a asp-action="Contact">Contact Page</a>
            </p>
    </div>
</div>
